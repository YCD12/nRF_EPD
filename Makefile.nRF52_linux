ifeq ($(USE_SYSVIEW),1)
SRC_FILES += \
  $(PROJ_DIR)/SystemView/SEGGER_RTT.c \
  $(PROJ_DIR)/SystemView/SEGGER_RTT_ASM_ARMv7M.S \
  $(PROJ_DIR)/SystemView/SEGGER_RTT_Syscalls_GCC.c \
