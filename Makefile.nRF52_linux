# =============================================================================
# 工具链配置
#   tools/gcc       → symlink 到打包的 arm-none-eabi-gcc 9.3.1
#   tools/nrf-tools → symlink 到打包的 nrf-command-line-tools（mergehex/nrfjprog）
# =============================================================================
TOOLS_DIR        := $(CURDIR)/tools
GNU_INSTALL_ROOT := $(TOOLS_DIR)/gcc/bin/
GNU_VERSION      := 9.3.1
GNU_PREFIX       := arm-none-eabi
NRF_TOOLS_BIN    := $(TOOLS_DIR)/nrf-tools/bin

export PATH := $(GNU_INSTALL_ROOT):$(NRF_TOOLS_BIN):$(HOME)/.local/bin:$(PATH)

# =============================================================================
# 项目配置（对应 Keil/EPD-nRF52.uvprojx → Target: nRF52811_xxAA）
# =============================================================================
PROJECT_NAME     := EPD-nRF52
TARGETS          := nrf52811_xxaa
OUTPUT_DIRECTORY := _build

PROJ_DIR := $(CURDIR)
SDK_ROOT := $(PROJ_DIR)/SDK/17.1.0_ddde560

# =============================================================================
# 调试选项：启用 RTT View 或 BLE 日志重定向
#   USE_RTT ?= 1 : 编译并使用原生的 SEGGER RTT View 输出日志 (此时会超 56KB 空间，仅用于调试)
#   USE_RTT ?= 0 : 默认值，不包含 RTT 模块 (在 56KB 内)
#   USE_BLE_LOG ?= 1 : 开启轻量级 BLE 日志重定向输出 (默认不开启以优化 Flash/RAM)
# =============================================================================
USE_RTT ?= 0
USE_SYSVIEW ?= 0
DEBUG_LAYOUT ?= 0
USE_BLE_LOG ?= 0

# 调试布局默认强制开启 RTT
ifeq ($(DEBUG_LAYOUT),1)
USE_RTT := 1
endif

ifeq ($(USE_SYSVIEW),1)
USE_RTT := 1
endif

ifeq ($(DEBUG_LAYOUT),1)
$(OUTPUT_DIRECTORY)/nrf52811_xxaa.out: \
  LINKER_SCRIPT  := $(SDK_ROOT)/gcc_nrf52_debug.ld
else
$(OUTPUT_DIRECTORY)/nrf52811_xxaa.out: \
  LINKER_SCRIPT  := $(SDK_ROOT)/gcc_nrf52.ld
endif

