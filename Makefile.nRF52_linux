LIB_FILES += \

# =============================================================================
# 编译选项
# 注意: __HEAP_SIZE/__STACK_SIZE 与 Keil 工程保持一致(HEAP=8192, STACK=2048)。
#   GUI 帧缓冲按 ph=(__HEAP_SIZE-512)/(width/8) 几乎吃满整个堆(见 GUI.c)。
#   GCC(-lnosys) 默认的 _sbrk 不检查栈、堆会越界长进栈区 -> 内存踩踏 -> 不停重启；
#   已由 gcc_sbrk.c 的带边界 _sbrk 把堆限制在链接器保留区 [__HeapBase,__HeapLimit)
#   内(超出返回 ENOMEM)，行为对齐 Keil/armcc 的"堆/栈各自固定区"，因此可安全用 8192。
# =============================================================================
OPT = -Os -g3 -flto

CFLAGS += $(OPT)
ifeq ($(USE_SYSVIEW),1)
CFLAGS += -DUSE_SYSVIEW
endif
CFLAGS += -DAPP_TIMER_V2
CFLAGS += -DAPP_TIMER_V2_RTC1_ENABLED
CFLAGS += -DCONFIG_GPIO_AS_PINRESET
CFLAGS += -DDEVELOP_IN_NRF52840
CFLAGS += -DFLOAT_ABI_SOFT
CFLAGS += -DNRF52811_XXAA
CFLAGS += -DNRFX_COREDEP_DELAY_US_LOOP_CYCLES=3
CFLAGS += -DNRF_DFU_SVCI_ENABLED
CFLAGS += -DNRF_DFU_TRANSPORT_BLE=1
CFLAGS += -DNRF_SD_BLE_API_VERSION=7
CFLAGS += -DS112
CFLAGS += -DSOFTDEVICE_PRESENT

# 根据 USE_BLE_LOG 与 USE_RTT 确定日志配置
ifeq ($(USE_BLE_LOG),1)
CFLAGS += -DBLE_LOG_REDIRECT_ALL_NRF_LOG=1
else
CFLAGS += -DBLE_LOG_REDIRECT_ALL_NRF_LOG=0
endif

ifeq ($(USE_RTT),1)
ifeq ($(USE_SYSVIEW),1)
ifeq ($(DEBUG_LAYOUT),1)
CFLAGS += -DNRF_LOG_ENABLED=1
else
CFLAGS += -DNRF_LOG_ENABLED=0
endif
else
CFLAGS += -DNRF_LOG_ENABLED=1
endif
else
CFLAGS += -DNRF_LOG_ENABLED=0 -DNRF_STRERROR_ENABLED=0
endif
CFLAGS += -mcpu=cortex-m4
CFLAGS += -mthumb -mabi=aapcs
CFLAGS += -Wall -Werror
CFLAGS += -mfloat-abi=soft
CFLAGS += -ffunction-sections -fdata-sections -fno-strict-aliasing
# Let GCC fold common C library calls into smaller built-ins.  The project does
# not replace libc string/memory routines, so disabling built-ins only wastes
# Flash on this size-constrained target.
CFLAGS += -fshort-enums

CXXFLAGS += $(OPT)

ASMFLAGS += -g3
ASMFLAGS += -mcpu=cortex-m4
ASMFLAGS += -mthumb -mabi=aapcs
ASMFLAGS += -mfloat-abi=soft
ASMFLAGS += -DAPP_TIMER_V2
ASMFLAGS += -DAPP_TIMER_V2_RTC1_ENABLED
ASMFLAGS += -DCONFIG_GPIO_AS_PINRESET
ASMFLAGS += -DDEVELOP_IN_NRF52840
ASMFLAGS += -DFLOAT_ABI_SOFT
ASMFLAGS += -DNRF52811_XXAA
ASMFLAGS += -DNRFX_COREDEP_DELAY_US_LOOP_CYCLES=3
ASMFLAGS += -DNRF_DFU_SVCI_ENABLED
ASMFLAGS += -DNRF_DFU_TRANSPORT_BLE=1
ASMFLAGS += -DNRF_SD_BLE_API_VERSION=7
ASMFLAGS += -DS112
ASMFLAGS += -DSOFTDEVICE_PRESENT

LDFLAGS += $(OPT)
LDFLAGS += -mthumb -mabi=aapcs -L$(SDK_ROOT)/modules/nrfx/mdk -T$(LINKER_SCRIPT)
LDFLAGS += -mcpu=cortex-m4
LDFLAGS += -Wl,--gc-sections
LDFLAGS += --specs=nano.specs
LDFLAGS += -Wl,-u,SWI2_IRQHandler
LDFLAGS += -Wl,-u,RTC1_IRQHandler
LDFLAGS += -Wl,-u,GPIOTE_IRQHandler
LDFLAGS += -Wl,-u,WDT_IRQHandler
LDFLAGS += -Wl,-u,SPIM0_SPIS0_SPI0_IRQHandler
LDFLAGS += -Wl,-u,TWIM0_TWIS0_TWI0_SPIM1_SPIS1_SPI1_IRQHandler

# 与 Keil 工程一致：HEAP=0（帧缓冲由静态 s_gfx_buffer 承担），STACK=2048
nrf52811_xxaa: CFLAGS += -D__HEAP_SIZE=0
nrf52811_xxaa: CFLAGS += -D__STACK_SIZE=2048
nrf52811_xxaa: ASMFLAGS += -D__HEAP_SIZE=0
nrf52811_xxaa: ASMFLAGS += -D__STACK_SIZE=2048

$(OUTPUT_DIRECTORY)/nrf52811_xxaa/ble_dfu.c.o: CFLAGS += -fno-lto
$(OUTPUT_DIRECTORY)/nrf52811_xxaa/ble_dfu_unbonded.c.o: CFLAGS += -fno-lto
$(OUTPUT_DIRECTORY)/nrf52811_xxaa/nrf_dfu_svci.c.o: CFLAGS += -fno-lto
$(OUTPUT_DIRECTORY)/nrf52811_xxaa/drv_rtc.c.o: CFLAGS += -fno-lto
$(OUTPUT_DIRECTORY)/nrf52811_xxaa/nrf_sdh.c.o: CFLAGS += -fno-lto
$(OUTPUT_DIRECTORY)/nrf52811_xxaa/nrfx_gpiote.c.o: CFLAGS += -fno-lto
$(OUTPUT_DIRECTORY)/nrf52811_xxaa/nrfx_wdt.c.o: CFLAGS += -fno-lto
$(OUTPUT_DIRECTORY)/nrf52811_xxaa/nrfx_spi.c.o: CFLAGS += -fno-lto
$(OUTPUT_DIRECTORY)/nrf52811_xxaa/nrfx_spim.c.o: CFLAGS += -fno-lto


LIB_FILES += -lc -lnosys -lm

TEMPLATE_PATH := $(SDK_ROOT)/components/toolchain/gcc

include $(TEMPLATE_PATH)/Makefile.common

$(foreach target, $(TARGETS), $(call define_target, $(target)))

# =============================================================================
# 便捷目标
# =============================================================================
.PHONY: default build clean rebuild ota flash flash_full flash_softdevice erase size memory info

default: build

build: nrf52811_xxaa
	@echo "=== Build completed ==="
	@$(MAKE) -f Makefile.nRF52_linux --no-print-directory size
	@$(MAKE) -f Makefile.nRF52_linux --no-print-directory memory

# 编译后生成 OTA 包 + 合并完整 hex
ota: build
	@echo "=== Generating OTA package ==="
	@chmod +x $(TOOLS_DIR)/make-ota-nrf52.sh
	$(TOOLS_DIR)/make-ota-nrf52.sh $(OUTPUT_DIRECTORY)/nrf52811_xxaa

# 覆盖 Makefile.common 中的 clean，扩展清理范围
clean:
	@echo "=== Cleaning ==="
	$(RM) $(OUTPUT_DIRECTORY)

rebuild: clean build

size: $(OUTPUT_DIRECTORY)/nrf52811_xxaa.out
	@$(GNU_INSTALL_ROOT)arm-none-eabi-size $(OUTPUT_DIRECTORY)/nrf52811_xxaa.out

# The default `size` output does not show the 2 KiB linker-reserved stack.
# Print the real partition headroom so a successful link is not mistaken for
# having enough RAM at runtime.
memory: $(OUTPUT_DIRECTORY)/nrf52811_xxaa.out
	@$(GNU_INSTALL_ROOT)arm-none-eabi-size -A $(OUTPUT_DIRECTORY)/nrf52811_xxaa.out | \
	awk 'BEGIN { flash = 57344; ram = 15656; stack = 2048; } \
	/^\.text[[:space:]]/ { text = $$2; } \
	/^\.data[[:space:]]/ { data = $$2; } \
	/^\.fs_data[[:space:]]/ { fs_data = $$2; } \
	/^\.bss[[:space:]]/ { bss = $$2; } \
	/^\.sdh_soc_observers[[:space:]]/ { flash_meta += $$2; } \
	/^\.sdh_ble_observers[[:space:]]/ { flash_meta += $$2; } \
	/^\.sdh_req_observers[[:space:]]/ { flash_meta += $$2; } \
	/^\.sdh_state_observers[[:space:]]/ { flash_meta += $$2; } \
	/^\.sdh_stack_observers[[:space:]]/ { flash_meta += $$2; } \
	/^\.ARM.exidx[[:space:]]/ { flash_meta += $$2; } \
	END { \
	  flash_used = text + data + fs_data + flash_meta; static_ram = data + fs_data + bss; ram_reserved = static_ram + stack; \
	  printf "=== Memory budget (nRF52811 application layout) ===\n"; \
	  printf "  Flash: %u / %u bytes (free %u)\n", flash_used, flash, flash - flash_used; \
	  printf "  RAM static: %u bytes (.data + .fs_data + .bss)\n", static_ram; \
	  printf "  RAM reserved: %u / %u bytes (includes %u-byte stack; free %u)\n", ram_reserved, ram, stack, ram - ram_reserved; \
	}'

# 烧录应用（需要已烧录 SoftDevice）
flash: build
	nrfjprog -f nrf52 --program $(OUTPUT_DIRECTORY)/nrf52811_xxaa.hex --sectorerase
	nrfjprog -f nrf52 --reset

# 烧录完整固件（SD + BL + App + Settings）
flash_full: ota
	nrfjprog -f nrf52 --program $(OUTPUT_DIRECTORY)/nrf52811_xxaa-full.hex --chiperase
	nrfjprog -f nrf52 --reset

flash_softdevice:
	nrfjprog -f nrf52 --program $(SDK_ROOT)/components/softdevice/s112/hex/s112_nrf52_7.3.0_softdevice.hex --sectorerase
	nrfjprog -f nrf52 --reset

erase:
	nrfjprog -f nrf52 --eraseall

info:
	@echo "Project:   $(PROJECT_NAME)"
	@echo "Target:    $(TARGETS)"
	@echo "GCC:       $(GNU_INSTALL_ROOT)"
	@echo "nRF tools: $(NRF_TOOLS_BIN)"
	@echo "SDK:       $(SDK_ROOT)"
	@echo "Output:    $(OUTPUT_DIRECTORY)"
