# Host GUI golden-image regression (Linux)
CC = gcc
CFLAGS = -std=c11 -Wall -Wextra -O2 \
         -D__HEAP_SIZE=32768 \
         -Itools/test/host/shim -IGUI -IEPD -Itools -Itools/test

SRCS = tools/test/host_stubs.c \
       tools/res_hal_host.c \
       tools/test/test_gui_golden.c \
       GUI/calendar_annotations.c \
       GUI/GUI.c \
       GUI/Lunar.c \
       GUI/Adafruit_GFX.c \
       GUI/u8g2_font.c \
       GUI/fonts.c \
       GUI/gui_porting_hal.c \
       GUI/ui_runtime.c

TARGET = /tmp/test_gui_golden
ANNOTATION_TARGET = /tmp/test_calendar_annotations
RES_BIN = tools/epd_resources.bin

.PHONY: all test update-golden clean

all: $(TARGET) $(ANNOTATION_TARGET)

$(TARGET): $(SRCS)
	$(CC) $(CFLAGS) -o $@ $(SRCS)

$(ANNOTATION_TARGET): tools/test/test_calendar_annotations.c GUI/calendar_annotations.c
	$(CC) $(CFLAGS) -o $@ tools/test/test_calendar_annotations.c GUI/calendar_annotations.c

test: all
	$(TARGET) $(RES_BIN)
	$(ANNOTATION_TARGET)

update-golden: $(TARGET)
	$(TARGET) $(RES_BIN) --update-golden

clean:
	rm -f $(TARGET) $(ANNOTATION_TARGET)
